{
  "expo": {
    "name": "ჩემი უბანი",
    "slug": "chemi-ubani",
    "version": "4.55.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": false
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ge.chemiubani.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "ახლო ბიზნესებისა და სერვისების საჩვენებლად საჭიროა მდებარეობაზე წვდომა.",
        "NSPhotoLibraryUsageDescription": "განცხადებასა და რეკლამაში ფოტოს ასატვირთად საჭიროა ფოტოებზე წვდომა.",
        "NSCameraUsageDescription": "დღის ფოტოს გადასაღებად საჭიროა კამერაზე წვდომა.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "39"
    },
    "android": {
      "package": "ge.chemiubani.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#f4f7f5"
      },
      "googleServicesFile": "./google-services.json",
      "versionCode": 39,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO"
      ],
      "allowBackup": false
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-4000-8000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f7f5"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#087a4b"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "დღის ფოტოს გადასაღებად საჭიროა კამერაზე წვდომა.",
          "recordAudioAndroid": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
