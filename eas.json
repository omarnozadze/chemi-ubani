{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": {
        "buildType": "apk"
      },
      "developmentClient": false,
      "env": {
        "NODE_ENV": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "NODE_ENV": "production"
      }
    },
    "ios-testflight": {
      "distribution": "store",
      "autoIncrement": false,
      "env": {
        "NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "ios-testflight": {}
  }
}
